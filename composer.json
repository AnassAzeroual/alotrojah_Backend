{
    "name": "alotrojah/backend-v2-native-php",
    "description": "AlOtrojah Quran Memorization Platform - Native PHP 8.5 Light-Speed REST API",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.5.0",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    }
}
